# Brewfile — install everything with: brew bundle
# Run from the repo root, or install.sh handles it automatically.

# ─── Taps ────────────────────────────────────────────────────────────────────
tap "homebrew/bundle"

# ─── Formulae ────────────────────────────────────────────────────────────────

# GitHub CLI
brew "gh"

# Git + extras
brew "git"
brew "tig"          # terminal git log viewer

# Fuzzy finder (used by shell config)
brew "fzf"

# File type associations (duti)
brew "duti"

# System monitoring
brew "htop"

# Networking
brew "wget"
brew "telnet"

# File utilities
brew "tree"

# Python version management
brew "pyenv"

# Python REPL with syntax highlighting
brew "bpython"

# SQLite
brew "sqlite"

# Ruby version management
brew "ruby"

# zsh plugins (used by .zshrc)
brew "zsh-syntax-highlighting"
brew "zsh-autosuggestions"

# ─── Casks (GUI apps) ────────────────────────────────────────────────────────

# Android debugging
cask "android-platform-tools"

# AI coding assistant
cask "claude-code"

# Google Cloud SDK
cask "gcloud-cli"

# Terminal (alternative to iTerm2)
cask "ghostty"

# API client
cask "insomnia"

# HTTP debugging proxy
cask "mitmproxy"
